# Copy to .env and fill in. Never commit .env.
MQTT_HOST=homeassistant.local      # IP/hostname of the Mosquitto broker (HA add-on → HA host IP)
MQTT_PORT=1883
MQTT_USER=price-tracker            # create a dedicated user in the Mosquitto add-on config
MQTT_PASSWORD=change-me
MQTT_TLS=false
DISCOVERY_PREFIX=homeassistant     # must match the MQTT integration's discovery prefix
TOPIC_PREFIX=price_tracker
LOG_LEVEL=INFO
# PER_HOST_DELAY=2                 # seconds between requests to the same shop
# REQUEST_TIMEOUT=30
# USER_AGENT=...
